# Servidor
PORT=3000
NODE_ENV=development
APP_URL=
API_KEY=cambia-por-una-clave-de-32-caracteres-o-mas
# Contraseña del panel /admin. Si queda vacía, se usa API_KEY como respaldo.
ADMIN_PASSWORD=
LOG_LEVEL=info

# Meta / WhatsApp Cloud API
# Completá la versión vigente que muestre Meta Developers para tu aplicación.
META_GRAPH_VERSION=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Endpoint cifrado de WhatsApp Flows. Mantener apagado hasta la prueba controlada.
FLOW_ENDPOINT_ENABLED=false
# Clave privada PEM. En hosting, guardar únicamente como variable secreta.
FLOW_ENDPOINT_MATERIAL=
FLOW_ENDPOINT_PASSPHRASE=
# Clave aleatoria de 32 bytes codificada en base64 para proteger datos almacenados.
FLOW_STORAGE_MATERIAL=
FLOW_INITIAL_SCREEN=INICIO

# Campañas: mantener apagado hasta completar staging y una prueba controlada.
CAMPAIGN_EXECUTION_ENABLED=false
CAMPAIGN_MAX_RECIPIENTS=250
CAMPAIGN_PREVIEW_TTL_MINUTES=60
CAMPAIGN_TIME_ZONE=America/Argentina/Buenos_Aires
CAMPAIGN_SEND_WINDOW_START_HOUR=9
CAMPAIGN_SEND_WINDOW_END_HOUR=18

# Resiliencia de solicitudes a Meta
META_REQUEST_TIMEOUT_MS=10000
META_MAX_RETRIES=2
META_RETRY_BASE_MS=250

# PostgreSQL
DATABASE_URL=postgresql://citycred:CAMBIAR_PASSWORD@localhost:5432/citycred_whatsapp
DATABASE_SSL=false
